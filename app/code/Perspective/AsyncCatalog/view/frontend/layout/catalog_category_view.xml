<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">

            <referenceBlock name="category.products" remove="true"/>

            <block class="Magento\Framework\View\Element\Template"
                   name="async.product-list"
                   template="Perspective_AsyncCatalog::catalog/product-list.phtml"
                   after="-">
                <arguments>
                    <argument name="viewModel" xsi:type="object">Perspective\AsyncCatalog\ViewModel\CatalogCategory</argument>
                </arguments>
            </block>

            <block class="Magento\Framework\View\Element\Template"
                   name="testik-alpine"
                   template="Perspective_AsyncCatalog::alpine-test.phtml"/>
        </referenceContainer>
    </body>
</page>
