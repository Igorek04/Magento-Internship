use Magento\Framework\View\Element\Template;
/** @var Template $block */
?>

<template x-if="categoryIsAnchor">

    <div class="block filter"
         x-data="{ aggregations: [], activeFilters: [], hasChanges: false }"
         @catalog-filters-updated.window="
            aggregations = $event.detail.aggregations;
            activeFilters = $event.detail.activeFilters;
            hasChanges = $event.detail.hasChanges;
         "
         x-show="aggregations.length > 0 || activeFilters.length > 0 || hasChanges">

        <div class="block-title filter-title">
            <strong><?= __('Shop By') ?></strong>
        </div>

        <div class="block-content filter-content">
            <?= $block->getChildHtml() ?>
        </div>
    </div>

</template>
