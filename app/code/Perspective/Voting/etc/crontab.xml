<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:magento-cron:etc/crontab.xsd">
    <group id="default">
        <job name="perspective_voting_auto_finish_by_date" instance="Perspective\Voting\Cron\FinishVotingByDate" method="execute">
            <config_path>perspective_voting/general_settings/voting_auto_finish_frequency</config_path>
        </job>

        <job name="perspective_voting_refresh_votes" instance="Perspective\Voting\Cron\RefreshVotes" method="execute">
            <config_path>perspective_voting/general_settings/votes_refresh_frequency</config_path>
        </job>
    </group>
</config>
