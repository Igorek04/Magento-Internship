<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
        <!-- For Voting Grid -->
        <type name="Perspective\Voting\Model\ResourceModel\Voting\Grid\Collection">
            <arguments>
                <argument name="mainTable" xsi:type="string">voting</argument>
                <argument name="eventPrefix" xsi:type="string">perspective_voting_grid_collection</argument>
                <argument name="eventObject" xsi:type="string">perspective_grid_collection</argument>
                <argument name="resourceModel" xsi:type="string">Perspective\Voting\Model\ResourceModel\Voting</argument>
            </arguments>
        </type>
        <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
            <arguments>
                <argument name="collections" xsi:type="array">
                    <item name="perspective_voting_listing_data_source" xsi:type="string">Perspective\Voting\Model\ResourceModel\Voting\Grid\Collection</item>
                </argument>
            </arguments>
        </type>
</config>
