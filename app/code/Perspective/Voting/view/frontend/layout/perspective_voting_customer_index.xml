<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../../../lib/internal/Magento/Framework/View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <body>
        <referenceBlock name="page.main.title">
            <action method="setPageTitle">
                <argument translate="true" name="title" xsi:type="string">My Votings</argument>
            </action>
        </referenceBlock>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template" name="votings_tab" template="Perspective_Voting::customer/votings_tab.phtml" >
                <block class="Perspective\Voting\Block\VotingList" name="voting.list.customer.all" template="Perspective_Voting::voting/list.phtml">
                    <arguments>
                        <argument name="active_only" xsi:type="boolean">false</argument>
                        <argument name="customer_votes" xsi:type="boolean">true</argument>
                    </arguments>
                    <block class="Perspective\Voting\Block\Widget\Voting" name="voting.widget.renderer" template="Perspective_Voting::widget/voting.phtml"/>
                </block>
            </block>
        </referenceContainer>
    </body>
</page>
