<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">perspective_voting_form.perspective_voting_form_data_source</item>
            <item name="deps" xsi:type="string">perspective_voting_form.perspective_voting_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">General Information</item>
        <item name="config" xsi:type="array">
            <item name="dataScope" xsi:type="string">data</item>
            <item name="namespace" xsi:type="string">perspective_voting_form</item>
        </item>
        <item name="spinner" xsi:type="string">general_information</item>
        <item name="buttons" xsi:type="array">
            <item name="back" xsi:type="string">Perspective\Voting\Block\Adminhtml\Index\Edit\Button\Back</item>
            <item name="finish" xsi:type="string">Perspective\Voting\Block\Adminhtml\Index\Edit\Button\Finish</item>
            <item name="delete" xsi:type="string">Perspective\Voting\Block\Adminhtml\Index\Edit\Button\Delete</item>
            <item name="save" xsi:type="string">Perspective\Voting\Block\Adminhtml\Index\Edit\Button\Save</item>
        </item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>

    <dataSource name="perspective_voting_form_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">Perspective\Voting\Model\DataProvider</argument>
            <argument name="name" xsi:type="string">perspective_voting_form_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">voting_id</argument>
            <argument name="requestFieldName" xsi:type="string">voting_id</argument>
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="submit_url" xsi:type="url" path="*/*/save" />
                </item>
            </argument>
        </argument>
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
    </dataSource>

    <fieldset name="general_information">
        <settings>
            <label translate="true">General Information</label>
        </settings>

        <field name="is_finished_label" formElement="input" sortOrder="50">
            <settings>
                <elementTmpl>ui/form/element/text</elementTmpl>
                <label translate="true">Voting Is Finished</label>
                <dataScope>is_finished_label</dataScope>
                <disabled>true</disabled>
            </settings>
        </field>

        <field name="title" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Title</label>
                <dataScope>title</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>

        <field name="description" formElement="textarea">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Description</label>
                <dataScope>description</dataScope>
            </settings>
        </field>

        <field name="management_type" formElement="select">
            <settings>
                <dataType>int</dataType>
                <label translate="true">Management Type</label>
                <dataScope>management_type</dataScope>
                <switcherConfig>
                    <rules>
                        <rule name="0">
                            <value>0</value> <actions>
                            <action name="0">
                                <target>${ $.ns }.${ $.ns }.general_information.status</target>
                                <callback>show</callback>
                            </action>
                            <action name="1">
                                <target>${ $.ns }.${ $.ns }.general_information.end_date</target>
                                <callback>hide</callback>
                            </action>
                            <action name="2">
                                <target>${ $.ns }.${ $.ns }.general_information.is_finished</target>
                                <callback>disabled</callback>
                                <params>
                                    <param name="0" xsi:type="boolean">false</param>
                                </params>
                            </action>
                        </actions>
                        </rule>
                        <rule name="1">
                            <value>1</value> <actions>
                            <action name="0">
                                <target>${ $.ns }.${ $.ns }.general_information.status</target>
                                <callback>hide</callback>
                            </action>
                            <action name="1">
                                <target>${ $.ns }.${ $.ns }.general_information.end_date</target>
                                <callback>show</callback>
                            </action>
                            <action name="2">
                                <target>${ $.ns }.${ $.ns }.general_information.is_finished</target>
                                <callback>disabled</callback>
                                <params>
                                    <param name="0" xsi:type="boolean">true</param>
                                </params>
                            </action>
                        </actions>
                        </rule>
                    </rules>
                    <enabled>true</enabled>
                </switcherConfig>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Perspective\Voting\Model\Source\ManagementType"/>
                    </settings>
                </select>
            </formElements>
        </field>

        <field name="status" formElement="checkbox">
            <settings>
                <label translate="true">Is Active (Manual Toggle)</label>
                <dataScope>status</dataScope>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>

        <field name="end_date" sortOrder="60" formElement="date">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string">End Date</item>
                    <item name="options" xsi:type="array">
                        <item name="dateFormat" xsi:type="string">yyyy-MM-dd</item>
                        <item name="timeFormat" xsi:type="string">HH:mm</item>
                        <item name="showsTime" xsi:type="boolean">true</item>
                        <item name="minDate" xsi:type="string">new Date()</item>
                    </item>
                </item>
            </argument>
            <settings>
                <dataType>timestamp</dataType>
                <dataScope>end_date</dataScope>
                <label translate="true">From</label>
            </settings>
        </field>

        <field name="allow_guests" formElement="checkbox">
            <settings>
                <label translate="true">Allow Guests</label>
                <dataScope>allow_guests</dataScope>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
    </fieldset>

    <dynamicRows name="options_container" sortOrder="100">
        <settings>
            <addButtonLabel translate="true">Add Option</addButtonLabel>
            <additionalClasses>
                <class name="admin__field-wide">true</class>
            </additionalClasses>
            <componentType>dynamicRows</componentType>
            <dataScope>data.options_container</dataScope>
            <identificationProperty>option_id</identificationProperty>
        </settings>
        <container name="record" component="Magento_Ui/js/dynamic-rows/record">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="isTemplate" xsi:type="boolean">true</item>
                    <item name="is_collection" xsi:type="boolean">true</item>
                    <item name="componentType" xsi:type="string">container</item>
                </item>
            </argument>

            <field name="option_id" formElement="input">
                <settings>
                    <dataType>text</dataType>
                    <visible>false</visible>
                    <dataScope>option_id</dataScope>
                </settings>
            </field>

            <field name="option_title" formElement="input">
                <settings>
                    <dataType>text</dataType>
                    <label translate="true">Option Title</label>
                    <dataScope>title</dataScope>
                    <validation>
                        <rule name="required-entry" xsi:type="boolean">true</rule>
                    </validation>
                </settings>
            </field>

            <field name="option_description" formElement="textarea">
                <settings>
                    <dataType>text</dataType>
                    <label translate="true">Option Description</label>
                    <dataScope>description</dataScope>
                </settings>
            </field>

            <field name="option_product_id" formElement="select" component="Magento_Ui/js/form/element/select">
                <settings>
                    <dataType>int</dataType>
                    <label translate="true">Linked Product</label>
                    <dataScope>product_id</dataScope>
                    <exports>
                        <link name="!value">${ $.parentName }.option_product_discount:disabled</link>
                    </exports>
                </settings>
                <formElements>
                    <select>
                        <settings>
                            <options class="Perspective\Voting\Model\Source\ProductList"/>
                        </settings>
                    </select>
                </formElements>
            </field>

            <field name="option_product_discount" formElement="input">
                <settings>
                    <label translate="true">Linked Product Discount (%)</label>
                    <dataScope>discount_percent</dataScope>
                    <disabled>true</disabled>
                    <imports>
                        <link name="disabled">!${ $.parentName }.option_product_id:value</link>
                    </imports>
                </settings>
            </field>

            <field name="option_additional_admin_votes" formElement="input">
                <settings>
                    <dataType>text</dataType>
                    <label translate="true">Additional Admin Votes</label>
                    <dataScope>additional_admin_votes</dataScope>
                    <imports>
                        <link name="disabled">!${ $.provider }:data.config.admin_allow_modify_votes</link>
                    </imports>
                </settings>
            </field>

            <actionDelete name="action_delete" template="Magento_Backend/dynamic-rows/cells/action-delete">
                <settings>
                    <componentType>actionDelete</componentType>
                    <dataType>text</dataType>
                    <label translate="true">Actions</label>
                </settings>
            </actionDelete>

            <field name="option_total_votes" formElement="input">
                <settings>
                    <dataType>text</dataType>
                    <label translate="true">Total Votes</label>
                    <dataScope>total_votes</dataScope>
                    <elementTmpl>ui/form/element/text</elementTmpl>
                    <imports>
                        <link name="componentDisabled">true</link>
                    </imports>
                </settings>
            </field>
        </container>
    </dynamicRows>
</form>
